generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MembershipRole {
  OWNER
  ADMIN
  DENTIST
  RECEPTIONIST
  ASSISTANT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum MedicalHistoryCategory {
  CONDITION
  ALLERGY
  MEDICATION
  SURGERY
}

enum ToothCondition {
  HEALTHY
  CARIES
  FILLED
  CROWN
  ROOT_CANAL_TREATED
  FRACTURED
  IMPLANT
  MISSING
  EXTRACTED
  IMPACTED
  OTHER
}

enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  BUCCAL
  LINGUAL
}

enum SurfaceCondition {
  CARIES
  RESTORATION
  SEALANT
  FRACTURE
  OTHER
}

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentProcedureStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TreatmentAppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TreatmentHistoryEntity {
  PLAN
  PROCEDURE
  APPOINTMENT
}

enum TreatmentHistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  RESCHEDULED
  CANCELLED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum BillingAuditAction {
  INVOICE_CREATED
  INVOICE_ISSUED
  PAYMENT_RECORDED
  REFUND_CREATED
  INVOICE_CANCELLED
  PAYMENT_RECONCILED
}

enum BillingAuditEntity {
  INVOICE
  PAYMENT
  REFUND
}


model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean @default(true)

  treatmentHistoryChanges TreatmentHistory[]          @relation("TreatmentHistoryActor")
  createdTreatmentPlans   TreatmentPlan[]             @relation("TreatmentPlanCreator")
  memberships             ClinicMembership[]
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]                  @relation("AuditActor")
  dentalChartChanges      DentalChartHistory[]        @relation("DentalChartHistoryActor")
  dentalSurfaceChanges    DentalChartSurfaceHistory[] @relation("DentalChartSurfaceHistoryActor")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive])
}

model Clinic {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  slug             String             @unique
  email            String?
  invoiceCounter InvoiceCounter?
  phone            String?
  refundCounter RefundCounter?
  countryCode      String             @default("IN")
  timezone         String             @default("Asia/Kolkata")
  currency         String             @default("INR")
  status           ClinicStatus       @default(ACTIVE)
  treatmentPlans   TreatmentPlan[]
  treatmentHistory TreatmentHistory[]
  billingAuditLogs BillingAuditLog[]
  paymentCounter PaymentCounter?
  memberships      ClinicMembership[]
  invoices Invoice[]
  branches         Branch[]
  patients         Patient[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model ClinicMembership {
  id       String           @id @default(uuid()) @db.Uuid
  userId   String           @db.Uuid
  clinicId String           @db.Uuid
  role     MembershipRole
  status   MembershipStatus @default(INVITED)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, clinicId])
  @@index([clinicId, status])
}

model DentalChartEntry {
  id        String @id @default(uuid()) @db.Uuid
  clinicId  String @db.Uuid
  patientId String @db.Uuid

  toothNumber String         @db.VarChar(2)
  condition   ToothCondition @default(HEALTHY)
  notes       String?

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  surfaces DentalChartSurface[]
  history  DentalChartHistory[]

  createdAt                   DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                    @updatedAt @db.Timestamptz(6)
  dentalChartSurfaceHistories DentalChartSurfaceHistory[]

  @@unique([clinicId, patientId, toothNumber])
  @@unique([id, clinicId, patientId])
  @@index([clinicId, patientId])
}

model DentalChartSurface {
  id           String @id @default(uuid()) @db.Uuid
  chartEntryId String @db.Uuid

  surface   ToothSurface
  condition SurfaceCondition
  notes     String?

  chartEntry DentalChartEntry            @relation(fields: [chartEntryId], references: [id], onDelete: Restrict)
  history    DentalChartSurfaceHistory[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([chartEntryId, surface])
  @@unique([id, chartEntryId])
  @@index([chartEntryId])
}

model Branch {
  id       String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid

  name    String
  address String?
  city    String?
  state   String?
  pincode String?

  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patients Patient[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([id, clinicId])
  @@unique([clinicId, name])
  @@index([clinicId])
}

model Patient {
  id                 String                @id @default(uuid()) @db.Uuid
  clinicId           String                @db.Uuid
  branchId           String                @db.Uuid
  medicalHistory     MedicalHistoryEntry[]
  patientNumber      String
  firstName          String
  lastName           String
  dateOfBirth        DateTime?             @db.Date
  gender             PatientGender         @default(UNKNOWN)
  dentalChartEntries DentalChartEntry[]
  treatmentPlans     TreatmentPlan[]
  treatmentHistory   TreatmentHistory[]
  phone              String?
  email              String?
  address            String?
  city               String?
  state              String?
  pincode            String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  branch Branch @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict)
  invoices Invoice[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([clinicId, patientNumber])
  @@unique([id, clinicId])
  @@index([clinicId, firstName, lastName])
  @@index([clinicId, phone])
  @@index([clinicId, createdAt])
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique

  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  deviceInfo String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  clinicId    String  @db.Uuid
  actorUserId String? @db.Uuid

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  ipAddress String?
  userAgent String?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  actor  User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([clinicId, createdAt])
  @@index([clinicId, entityType, entityId])
  @@index([actorUserId, createdAt])
}

model MedicalHistoryEntry {
  id        String @id @default(uuid()) @db.Uuid
  clinicId  String @db.Uuid
  patientId String @db.Uuid

  category MedicalHistoryCategory
  title    String
  details  String?
  isActive Boolean                @default(true)

  recordedAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([clinicId, patientId, category])
  @@index([patientId, createdAt])
}

model DentalChartHistory {
  id           String @id @default(uuid()) @db.Uuid
  clinicId     String @db.Uuid
  patientId    String @db.Uuid
  chartEntryId String @db.Uuid

  previousCondition ToothCondition?
  newCondition      ToothCondition

  previousNotes String?
  newNotes      String?

  changedBy String   @db.Uuid
  changedAt DateTime @default(now()) @db.Timestamptz(6)

  chartEntry DentalChartEntry @relation(fields: [chartEntryId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)

  changedByUser User @relation("DentalChartHistoryActor", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, changedAt])
  @@index([chartEntryId, changedAt])
  @@index([changedBy])
}

model DentalChartSurfaceHistory {
  id           String @id @default(uuid()) @db.Uuid
  clinicId     String @db.Uuid
  patientId    String @db.Uuid
  chartEntryId String @db.Uuid
  surfaceId    String @db.Uuid

  previousCondition SurfaceCondition?
  newCondition      SurfaceCondition

  previousNotes String?
  newNotes      String?

  changedBy String   @db.Uuid
  changedAt DateTime @default(now()) @db.Timestamptz(6)

  surface DentalChartSurface @relation(fields: [surfaceId, chartEntryId], references: [id, chartEntryId], onDelete: Restrict)

  chartEntry DentalChartEntry @relation(fields: [chartEntryId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)

  changedByUser User @relation("DentalChartSurfaceHistoryActor", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, changedAt])
  @@index([surfaceId, changedAt])
  @@index([changedBy])
}

model TreatmentPlan {
  id        String @id @default(uuid()) @db.Uuid
  clinicId  String @db.Uuid
  patientId String @db.Uuid
  createdBy String @db.Uuid
  invoices Invoice[]
  title         String              @db.VarChar(200)
  description   String?
  clinicalNotes String?
  status        TreatmentPlanStatus @default(DRAFT)

  startDate   DateTime? @db.Date
  targetDate  DateTime? @db.Date
  completedAt DateTime? @db.Timestamptz(6)

  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  creator User    @relation("TreatmentPlanCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  procedures TreatmentProcedure[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@unique([id, clinicId])
  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, status])
  @@index([createdBy])
}

model TreatmentProcedure {
  id              String @id @default(uuid()) @db.Uuid
  clinicId        String @db.Uuid
  treatmentPlanId String @db.Uuid

  name        String                   @db.VarChar(200)
  description String?
  toothNumber String?                  @db.VarChar(2)
  status      TreatmentProcedureStatus @default(PLANNED)

  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)

  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  treatmentPlan TreatmentPlan @relation(fields: [treatmentPlanId, clinicId], references: [id, clinicId], onDelete: Restrict)

  appointments TreatmentAppointment[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([id, clinicId])
  @@index([clinicId, treatmentPlanId])
  @@index([clinicId, status])
  @@index([clinicId, toothNumber])
}

model TreatmentAppointment {
  id                   String @id @default(uuid()) @db.Uuid
  clinicId             String @db.Uuid
  treatmentProcedureId String @db.Uuid

  scheduledAt     DateTime                   @db.Timestamptz(6)
  durationMinutes Int                        @default(30)
  status          TreatmentAppointmentStatus @default(SCHEDULED)

  notes      String?
  outcome    String?
  actualCost Decimal? @db.Decimal(12, 2)

  treatmentProcedure TreatmentProcedure @relation(fields: [treatmentProcedureId, clinicId], references: [id, clinicId], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([id, clinicId])
  @@index([clinicId, treatmentProcedureId, scheduledAt])
  @@index([clinicId, scheduledAt])
  @@index([clinicId, status])
}

model TreatmentHistory {
  id        String @id @default(uuid()) @db.Uuid
  clinicId  String @db.Uuid
  patientId String @db.Uuid
  changedBy String @db.Uuid

  entityType TreatmentHistoryEntity
  entityId   String                 @db.Uuid
  action     TreatmentHistoryAction

  previousData Json?
  newData      Json?

  changedAt DateTime @default(now()) @db.Timestamptz(6)

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  actor   User    @relation("TreatmentHistoryActor", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, changedAt])
  @@index([clinicId, entityType, entityId])
  @@index([changedBy, changedAt])
}
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  clinicId        String        @db.Uuid
  patientId       String        @db.Uuid
  treatmentPlanId String?       @db.Uuid

  invoiceNumber   String
  status          InvoiceStatus @default(DRAFT)

  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)

  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal       @default(0) @db.Decimal(12, 2)

  issuedAt       DateTime?
  dueDate        DateTime?
  notes          String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient        Patient        @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict)
  treatmentPlan  TreatmentPlan? @relation(fields: [clinicId, treatmentPlanId], references: [clinicId, id], onDelete: Restrict)

  items          InvoiceItem[]
  payments       Payment[]

  @@unique([clinicId, invoiceNumber])
  @@unique([clinicId, id])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@index([treatmentPlanId])
}
model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  invoiceId   String   @db.Uuid

  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount Decimal  @db.Decimal(12, 2)

  treatmentProcedureId String? @db.Uuid

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     Invoice @relation(fields: [clinicId, invoiceId], references: [clinicId, id], onDelete: Restrict)

  @@unique([clinicId, id])
  @@index([clinicId, invoiceId])
  @@index([treatmentProcedureId])
}
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  clinicId      String        @db.Uuid
  invoiceId     String        @db.Uuid

  paymentNumber String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)

  
  transactionId String?
  reference     String?
  notes         String?

  receivedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  invoice       Invoice       @relation(fields: [clinicId, invoiceId], references: [clinicId, id], onDelete: Restrict)
  refunds Refund[]
  @@unique([clinicId, paymentNumber])
  @@unique([clinicId, id])
  @@index([clinicId, invoiceId])
  @@index([transactionId])
}
model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String   @db.Uuid
  paymentId   String   @db.Uuid

  refundNumber String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  reference   String?
  notes       String?

  refundedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  payment     Payment  @relation(fields: [clinicId, paymentId], references: [clinicId, id], onDelete: Restrict)

  @@unique([clinicId, refundNumber])
  @@index([clinicId, paymentId])
}

model InvoiceCounter {
  clinicId String @id @db.Uuid
  lastNumber Int @default(0)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
}
model PaymentCounter {
  clinicId  String @id @db.Uuid
  lastNumber Int   @default(0)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
}
model RefundCounter {
  clinicId  String @id @db.Uuid
  lastNumber Int   @default(0)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
}
model BillingAuditLog {
  id          String             @id @default(uuid()) @db.Uuid
  clinicId    String             @db.Uuid
  userId      String             @db.Uuid
  entity      BillingAuditEntity
  entityId    String             @db.Uuid
  action      BillingAuditAction
  description  String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime           @default(now())

  clinic      Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@index([clinicId, createdAt])
  @@index([clinicId, entity, entityId])
  @@index([clinicId, userId, createdAt])
}